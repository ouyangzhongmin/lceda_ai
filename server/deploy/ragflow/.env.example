# RAGFlow local deployment for lceda_ai
# Copy to .env before first start.

DOC_ENGINE=elasticsearch
DEVICE=cpu
COMPOSE_PROFILES=${DOC_ENGINE},${DEVICE}

STACK_VERSION=8.11.3
MEM_LIMIT=4294967296

# Vector DB / Search
ES_HOST=es01
ES_PORT=21200
ELASTIC_PASSWORD=change_me_elastic_password

OS_HOST=opensearch01
OS_PORT=21201
OPENSEARCH_PASSWORD=change_me_opensearch_password_01!

# Core dependencies
MYSQL_HOST=mysql
MYSQL_DBNAME=rag_flow
MYSQL_PORT=3306
EXPOSE_MYSQL_PORT=23306
MYSQL_PASSWORD=change_me_mysql_password
MYSQL_MAX_PACKET=1073741824

REDIS_HOST=redis
REDIS_PORT=26379
REDIS_PASSWORD=change_me_redis_password

MINIO_HOST=minio
MINIO_PORT=39000
MINIO_CONSOLE_PORT=39001
MINIO_USER=rag_flow
MINIO_PASSWORD=change_me_minio_password

# RAGFlow web/api ports on host
SVR_WEB_HTTP_PORT=38080
SVR_WEB_HTTPS_PORT=38443
SVR_HTTP_PORT=39380
ADMIN_SVR_HTTP_PORT=39381
SVR_MCP_PORT=39382
GO_HTTP_PORT=39384
GO_ADMIN_PORT=39383

API_PROXY_SCHEME=python
RAGFLOW_IMAGE=infiniflow/ragflow:v0.24.0

# Optional embedding service (disabled by default)
TEI_IMAGE_CPU=infiniflow/text-embeddings-inference:cpu-1.8
TEI_IMAGE_GPU=infiniflow/text-embeddings-inference:1.8
TEI_MODEL=Qwen/Qwen3-Embedding-0.6B
TEI_HOST=tei
TEI_PORT=26380

TZ=Asia/Shanghai
REGISTER_ENABLED=1
